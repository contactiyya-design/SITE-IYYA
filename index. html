nav.menu{display:flex;gap:18px}
nav.menu > div{position:relative}
nav.menu a{font-size:11px;letter-spacing:1.6px;text-transform:uppercase;color:var(--ink);padding:6px 0;border-bottom:1px solid transparent;transition:.25s;display:inline-block;white-space:nowrap}
nav.menu a:hover{border-color:var(--gold);color:var(--navy)}
nav.menu .top{display:flex;align-items:center;gap:6px;cursor:pointer;height:78px}
nav.menu .car{font-size:9px;color:var(--gold)}
.sub{position:absolute;top:78px;left:-18px;min-width:280px;background:#fff;border:1px solid var(--line);box-shadow:0 22px 44px rgba(20,30,50,.12);padding:8px 0;opacity:0;visibility:hidden;transform:translateY(8px);transition:.25s;display:flex;flex-direction:column}
nav.menu > div:hover .sub{opacity:1;visibility:visible;transform:translateY(0)}
.sub a{display:block;width:100%;padding:12px 24px;font-size:11.5px;letter-spacing:2px;border-bottom:1px solid var(--bg2);white-space:nowrap}
.sub a:last-child{border-bottom:none}
.sub a:hover{background:var(--bg2);color:var(--gold);padding-left:30px}
.burger{display:none;font-size:24px;background:none;border:none;color:var(--navy);cursor:pointer}
