*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Jost',sans-serif;color:var(--ink);background:var(--bg);font-weight:300;line-height:1.7}
h1,h2,h3,.serif{font-family:'Cormorant Garamond',serif;font-weight:500;color:var(--navy)}
