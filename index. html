<script>
window.__langNames = {en:'Anglais', es:'Espagnol', ru:'Russe', 'zh-CN':'Chinois (simplifi\u00e9)'};
window.__applyLang = function(lang){
  if(!lang || lang === 'fr') return;
  var opener = document.querySelector('#google_translate_element a[aria-haspopup="true"]');
  if(!opener){ return; }
  opener.click();
  var tries = 0;
  var findFrame = function(){
    var frame = document.querySelector('iframe.VIpgJd-ZVi9od-xl07Ob-OEVmcd');
    var target = null;
    if(frame){
      try{
        var links = frame.contentDocument.querySelectorAll('a');
        for(var i=0;i<links.length;i++){
          if(links[i].textContent.indexOf(window.__langNames[lang]) !== -1){ target = links[i]; break; }
        }
      }catch(e){}
    }
    if(target){ target.click(); return; }
    if(tries < 20){ tries++; setTimeout(findFrame, 150); }
  };
  setTimeout(findFrame, 150);
};
window.setSiteLang = function(ev){
  var lang = ev.currentTarget.getAttribute('data-lang');
  try{ localStorage.setItem('iyya_site_lang', lang); }catch(e){}
  if(lang === 'fr'){ window.location.reload(); return; }
  window.__applyLang(lang);
};
window.googleTranslateElementInit = function(){
  if(window.__gte_inited) return; window.__gte_inited = true;
  new google.translate.TranslateElement({pageLanguage:'fr', includedLanguages:'en,es,ru,zh-CN', layout: google.translate.TranslateElement.InlineLayout.SIMPLE, autoDisplay:true}, 'google_translate_element');
  var saved;
  try{ saved = localStorage.getItem('iyya_site_lang'); }catch(e){}
  if(saved && saved !== 'fr'){ setTimeout(function(){ window.__applyLang(saved); }, 700); }
};
</script>
<script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
