    }
  }

  renderVals(){
    return {
      setLangFn: (typeof window!=='undefined' ? window.setSiteLang : function(){}),
      langEnHref: (typeof window!=='undefined' ? 'https://translate.google.com/translate?sl=fr&tl=en&u='+encodeURIComponent(window.location.href) : '#'),
      langEsHref: (typeof window!=='undefined' ? 'https://translate.google.com/translate?sl=fr&tl=es&u='+encodeURIComponent(window.location.href) : '#'),
      langRuHref: (typeof window!=='undefined' ? 'https://translate.google.com/translate?sl=fr&tl=ru&u='+encodeURIComponent(window.location.href) : '#'),
      langZhHref: (typeof window!=='undefined' ? 'https://translate.google.com/translate?sl=fr&tl=zh-CN&u='+encodeURIComponent(window.location.href) : '#'),
      modalCls: this.state.modalOpen ? 'open' : '',
      mmenuCls: this.state.menuOpen ? 'open' : '',
      toggleMenu: ()=> this.setState(s=>({ menuOpen: !s.menuOpen })),
      openBrief: (e)=>{ if(e && e.preventDefault) e.preventDefault(); this.setState({ modalOpen:true }); },
      submitFicheContact: (e)=>{
        e.preventDefault();
        const f = new FormData(e.target);
        const g = (k)=> (f.get(k)||'').toString().trim();
        const msg = "FICHE CONTACT \u2014 Site IYYA%0A"
          + "Nom : " + g('nom') + "%0A"
          + "T\u00e9l : " + g('tel') + " \u2014 Email : " + g('email');
        if(this.cmod){ this.cmod.addContact({ id:'k'+Date.now().toString(36)+Math.random().toString(36).slice(2,7), date:new Date().toISOString(), type:'Fiche contact', nom:g('nom'), tel:g('tel'), email:g('email'), detail:'' }); }
        this._sendEmailNotif({ type:'Fiche contact', nom:g('nom'), tel:g('tel'), email:g('email'), detail:'' });
        window.open("https://wa.me/33662230261?text=" + msg, "_blank");
        e.target.reset();
      },
      closeBrief: ()=> this.setState({ modalOpen:false }),
      onBackdrop: (e)=>{ if(e.target === e.currentTarget) this.setState({ modalOpen:false }); },
      submitBrief: (e)=>{
        e.preventDefault();
        const f = new FormData(e.target);
        const g = (k)=> f.get(k) || '';
        const msg = "RECHERCHE DE BIEN \u2014 " + g('nom') + "%0A"
          + "Type : " + g('type') + " (" + g('etat') + ")%0A"
          + "Lieu : " + g('lieu') + "%0A"
          + "Budget : " + g('bmin') + " \u2013 " + g('bmax') + "%0A"
          + "Pi\u00e8ces : " + g('pieces') + " \u2014 Objectif : " + g('objectif') + "%0A"
          + "Pr\u00e9cisions : " + g('detail');
        const detailTxt = 'Type : '+g('type')+' ('+g('etat')+') — Lieu : '+g('lieu')+' — Budget : '+g('bmin')+'-'+g('bmax')+' — Pi\u00e8ces : '+g('pieces')+' — Objectif : '+g('objectif')+' — '+g('detail');
        if(this.cmod){ this.cmod.addContact({ id:'k'+Date.now().toString(36)+Math.random().toString(36).slice(2,7), date:new Date().toISOString(), type:'Recherche de bien', nom:String(g('nom')||''), tel:'', email:'', detail: detailTxt }); }
        this._sendEmailNotif({ type:'Recherche de bien', nom:String(g('nom')||''), tel:'', email:'', detail: detailTxt });
        window.open("https://wa.me/33662230261?text=" + msg, "_blank");
      },
      bindBiens: (el)=>{ if(el && el!==this.biensWrap){ this.biensWrap = el; } },
      onBiensChange: ()=> this._applyBiens(),
      featured: (this.state.biens||[]).slice(0,9).map(b=>({
        pays: b.pays||'', secteur: b.secteur||'', quartier: b.quartier||'', type: b.type||'',
        price: String(parseInt(String(b.price||'').replace(/[^\d]/g,''),10)||0),
        surface: b.surface || (b.surfaceTerrain ? b.surfaceTerrain : ''), featuresStr: (b.features||[]).join('|'),
        hasTag: !!b.tag, tag: b.tag||'',
        phStyle: { width:'100%', height:'100%', backgroundSize:'cover', backgroundPosition:'center', backgroundImage: 'url("'+((b.photos&&b.photos[0])||'assets/02-villa-jour.jpg')+'")' },
        title: b.title||'', loc: [b.secteur,b.pays].filter(Boolean).join(' — '),
        priceText: b.priceText||'', pieces: b.pieces||'',
        feat1: (b.features&&b.features[0])||'',
        open: ()=>{ if(typeof window!=='undefined') window.location.href='Nos biens.dc.html'; }
      })),
      bindRoot: (el)=>{ if(el && el!==this.root){ this.root = el; this._cache(); } },
      togglePlay: ()=> this.playing ? this.pause() : this.play(),
      replay: ()=>{ this.t = 0; this._syncVideo(true); this.play(); },
      onSeek: (e)=>{ this.seeking = true; this.t = Math.min(this.DUR, Math.max(0, parseFloat(e.target.value)||0)); this._syncVideo(true); this.frame(); },
      onSeekEnd: ()=>{ this.seeking = false; }
    };
  }

  _cache(){
    const r = this.root;
    this.layers = Array.from(r.querySelectorAll('[data-shot]'));
    this.kb = this.layers.map(l => l.querySelector('[data-kb]'));
    this.video = r.querySelector('video[data-kb]');
    this.capEl = r.querySelector('[data-caption]');
    this.endEl = r.querySelector('[data-endcard]');
    this.introEl = r.querySelector('[data-intro]');
    this.sceneNum = r.querySelector('[data-scene-num]');
    this.sceneName = r.querySelector('[data-scene-name]');
    this.progEl = r.querySelector('[data-progress]');
    this.timeEl = r.querySelector('[data-time]');
    this.scrub = r.querySelector('[data-scrub]');
    this.toggleIcon = r.querySelector('[data-toggle-icon]');
    this.frame();
    const auto = this.props.autostart !== false;
    if(auto){ setTimeout(()=> this.play(), 350); }
  }

  componentWillUnmount(){ if(this.raf) cancelAnimationFrame(this.raf); }

  _applyBiens(){
    const w = this.biensWrap;
    if(!w) return;
    const val = (f)=>{ const el = w.querySelector('[data-f="'+f+'"]'); return el ? el.value : ''; };
    const sort = val('sort'), secteur = val('secteur'), type = val('type'), feature = val('feature'), quartier = val('quartier');
    const grid = w.querySelector('[data-grid]');
    const empty = w.querySelector('[data-empty]');
    if(!grid) return;
    const cards = Array.from(grid.querySelectorAll('.card'));
    const visible = [];
    cards.forEach(c=>{
      const feats = (c.dataset.features || '').split('|');
      let okSect = true;
      if(secteur){
        okSect = secteur.indexOf('pays:') === 0
          ? c.dataset.pays === secteur.slice(5)
          : c.dataset.secteur === secteur;
      }
      const ok = okSect
        && (!type || c.dataset.type === type)
        && (!feature || feats.indexOf(feature) !== -1)
        && (!quartier || c.dataset.quartier === quartier);
      c.style.display = ok ? '' : 'none';
      if(ok) visible.push(c);
    });
    if(sort){
      visible.sort((a,b)=>{
        if(sort === 'prix-desc') return (+b.dataset.price) - (+a.dataset.price);
        if(sort === 'prix-asc')  return (+a.dataset.price) - (+b.dataset.price);
        if(sort === 'surface-desc') return (+b.dataset.surface) - (+a.dataset.surface);
        return 0;
      });
      visible.forEach(c=> grid.appendChild(c));
    }
    if(empty) empty.style.display = visible.length ? 'none' : 'block';
  }

  play(){
    if(!this.root) return;
    if(this.t >= this.DUR) this.t = 0;
    this.playing = true;
    if(this.toggleIcon) this.toggleIcon.textContent = '\u275a\u275a';
    if(this.introEl){ this.introEl.style.opacity = '0'; this.introEl.style.pointerEvents = 'none'; }
    this._syncVideo();
    this.last = performance.now();
    if(this.raf) cancelAnimationFrame(this.raf);
    this.raf = requestAnimationFrame((t)=> this.tick(t));
  }

  pause(){
    this.playing = false;
    if(this.toggleIcon) this.toggleIcon.textContent = '\u25b6';
    if(this.raf) cancelAnimationFrame(this.raf);
    if(this.video) this.video.pause();
    this.videoPlaying = false;
  }

  tick(now){
    const dt = Math.min(0.05, (now - this.last)/1000);
    this.last = now;
    if(this.playing){
      this.t += dt;
      if(this.t >= this.DUR){
        const loop = this.props.loopFilm !== false;
        if(loop){ this.t = this.t % this.DUR; this._syncVideo(true); }
        else { this.t = this.DUR; this.frame(); this.pause(); return; }
      }
    }
    this.frame();
    if(this.playing) this.raf = requestAnimationFrame((t)=> this.tick(t));
  }

  _syncVideo(reset){
    if(!this.video) return;
    if(reset){ try { this.video.currentTime = 0; } catch(e){} this.videoPlaying = false; }
  }

  _sm(x){ x = Math.max(0, Math.min(1, x)); return x*x*(3-2*x); }

  _kbTransform(type, p){
    let z, tx = 0, ty = 0;
    const range = 0.15;
    if(type === 'zi'){ z = 1.03 + p*0.10; }
    else if(type[0] === 'i'){ z = 1.05 + p*range; }
    else { z = 1.05 + range - p*range; }
    const dir = type[1];
    const amt = 3.6;
    if(dir === 'l'){ tx = amt - p*2*amt; }
    else if(dir === 'r'){ tx = -amt + p*2*amt; }
    else { ty = -1.2 + p*2.4; }
    return 'scale(' + z.toFixed(4) + ') translate(' + tx.toFixed(2) + '%,' + ty.toFixed(2) + '%)';
  }

  frame(){
    const t = this.t, fade = 0.75;
    for(let i=0;i<this.timing.length;i++){
      const {s,d,k} = this.timing[i];
      const e = s + d;
      const inA = this._sm((t - (s - fade/2)) / fade);
      const outA = this._sm(((e + fade/2) - t) / fade);
      let op = Math.min(inA, outA);
      if(i === 0){ op = Math.max(op, this._sm((t - (this.DUR - fade/2)) / fade)); }
      const layer = this.layers[i];
      if(!layer) continue;
      layer.style.opacity = op.toFixed(3);
      if(op > 0.004){
        const p = Math.max(0, Math.min(1, (t - s)/d));
        this.kb[i].style.transform = this._kbTransform(k, p);
      }
    }
    if(this.video){
      const inShot1 = t < 8.2;
      if(this.playing && inShot1){
        if(!this.videoPlaying){ const pr = this.video.play(); if(pr && pr.catch) pr.catch(()=>{}); this.videoPlaying = true; }
      } else if(this.videoPlaying){ this.video.pause(); this.videoPlaying = false; }
    }
    let cap = '', capOp = 0;
    for(const c of this.captions){
      const o = Math.min(this._sm((t - c.a)/0.6), this._sm((c.b - t)/0.6));
      if(o > capOp){ capOp = o; cap = c.t; }
    }
    const endFade = this._sm((t - 56.4)/1.4);
    if(endFade > 0.02) capOp = 0;
    if(this.capEl){
      if(cap && this.capEl.textContent !== cap) this.capEl.textContent = cap;
      this.capEl.style.opacity = capOp.toFixed(3);
    }
    let sc = this.scenes[0];
    for(const s of this.scenes){ if(t >= s.s) sc = s; }
    if(this.curLabel !== sc.n){
      this.curLabel = sc.n;
      if(this.sceneNum){ this.sceneNum.style.opacity = '0'; this.sceneName.style.opacity = '0';
        setTimeout(()=>{ if(this.curLabel===sc.n){ this.sceneNum.textContent = sc.n; this.sceneName.textContent = sc.t; this.sceneNum.style.opacity='1'; this.sceneName.style.opacity='1'; } }, 220);
      }
    }
    if(this.endEl){
      const eo = this._sm((t - 56.4)/1.4);
      this.endEl.style.opacity = eo.toFixed(3);
      this.endEl.style.pointerEvents = eo > 0.5 ? 'auto' : 'none';
      if(eo > 0.02){
        const lblOp = (1 - Math.min(1, eo)).toFixed(3);
        if(this.sceneNum) this.sceneNum.style.opacity = lblOp;
        if(this.sceneName) this.sceneName.style.opacity = lblOp;
      }
    }
    const frac = t / this.DUR;
    if(this.progEl) this.progEl.style.width = (frac*100).toFixed(2) + '%';
    if(this.scrub && !this.seeking) this.scrub.value = t;
    if(this.timeEl) this.timeEl.textContent = this._fmt(t) + ' / 1:00';
  }

  _fmt(s){ s = Math.max(0, Math.floor(s)); const m = Math.floor(s/60); const r = s%60; return m + ':' + String(r).padStart(2,'0'); }
}
</script>
