    const body = 'Nom : ' + (data.nom||'') + '\nTéléphone : ' + (data.tel||'') + '\nEmail : ' + (data.email||'') + (data.detail ? ('\n\n' + data.detail) : '');
    if(EMAILJS_SERVICE_ID && EMAILJS_TEMPLATE_ID && EMAILJS_PUBLIC_KEY && typeof window!=='undefined'){
      const send = ()=>{
        if(!window.emailjs) return;
