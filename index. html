          to_email: 'contactiyya@gmail.com', from_name: data.nom||'Visiteur site', reply_to: data.email||'',
          subject, message: body, nom:data.nom||'', tel:data.tel||'', email:data.email||'', detail:data.detail||''
        }, EMAILJS_PUBLIC_KEY).catch(()=>{});
      };
      if(window.emailjs){ send(); }
      else {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
        s.onload = send;
        document.head.appendChild(s);
